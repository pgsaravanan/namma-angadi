generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ShopStatus {
  ACTIVE
  SUSPENDED
}

enum ShopRole {
  SUPER_ADMIN
  ADMIN
}

enum DiscountType {
  PERCENT
  FLAT
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  FAILED
  EXPIRED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Shop {
  id                     String     @id @default(cuid())
  slug                   String     @unique
  name                   String
  customDomain           String?    @unique
  status                 ShopStatus @default(ACTIVE)
  supportEmail           String?
  supportPhone           String?
  contactName            String?
  isAcceptingOrders      Boolean    @default(true)
  openTime               String?
  closeTime              String?
  openDays               String     @default("mon,tue,wed,thu,fri,sat,sun")
  deliveryEnabled        Boolean    @default(true)
  deliveryFeePaise       Int        @default(0)
  freeDeliveryAbovePaise Int?
  minOrderPaise          Int        @default(0)
  deliveryPincodes       String?
  deliveryNote           String?
  pickupEnabled          Boolean    @default(false)
  fssaiNumber            String?
  gstin                  String?
  legalName              String?
  shopState              String?
  defaultGstRate         Int        @default(5)
  notifyEmail            String?
  logoUrl                String?
  heroImageUrl           String?
  heroTitle              String?
  heroSubtitle           String?
  announcement           String?
  about                  String?
  address                String?
  paymentMethods         String     @default("upi")
  paymentProvider        String?
  paymentCredentialsEnc  String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  members          Membership[]
  products         Product[]
  categories       Category[]
  policies         ShopPolicy[]
  customerAccounts CustomerAccount[]
  coupons          Coupon[]
  customers        Customer[]
  orders           Order[]
  sessions         Session[]
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  passwordHash    String
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())

  memberships Membership[]
  sessions    Session[]
}

model Membership {
  id        String   @id @default(cuid())
  shopId    String
  userId    String
  role      ShopRole
  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
}

model Session {
  id        String   @id
  userId    String
  shopId    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop? @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Product {
  id          String   @id @default(cuid())
  shopId      String
  categoryId  String?
  name        String
  description String   @default("")
  imageUrl    String?
  pricePaise  Int
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  foodType    String?
  hsnCode     String?
  gstRate     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop     Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variants ProductVariant[]
  items    OrderItem[]
  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([shopId, isActive])
}

model Coupon {
  id               String       @id @default(cuid())
  shopId           String
  code             String
  type             DiscountType
  value            Int
  minOrderPaise    Int          @default(0)
  maxDiscountPaise Int?
  usageLimit       Int?
  usedCount        Int          @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())

  shop   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([shopId, code])
}

model Customer {
  id        String   @id @default(cuid())
  shopId    String
  name      String
  phone     String
  email     String?
  createdAt DateTime @default(now())

  shop   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([shopId, phone])
}

model Order {
  id                String      @id @default(cuid())
  shopId            String
  customerId        String
  couponId          String?
  number            Int
  accessToken       String      @unique
  status            OrderStatus @default(PENDING)
  subtotalPaise     Int
  discountPaise     Int         @default(0)
  totalPaise        Int
  addressLine1      String
  addressLine2      String?
  city              String
  state             String
  pincode           String
  customerName      String
  customerPhone     String
  customerEmail     String?
  provider          String?
  providerOrderId   String?
  attentionNote     String?
  deliveryMethod    String      @default("delivery")
  deliveryFeePaise  Int         @default(0)
  invoiceNumber     Int?
  sellerGstin       String?
  customerAccountId String?
  expiresAt         DateTime
  paidAt            DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer        Customer         @relation(fields: [customerId], references: [id])
  coupon          Coupon?          @relation(fields: [couponId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  refunds         Refund[]
  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)

  @@unique([shopId, number])
  @@unique([shopId, invoiceNumber])
  @@unique([provider, providerOrderId])
  @@index([customerAccountId])
  @@index([shopId, customerPhone, status])
  @@index([shopId, status])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  name           String
  unitPricePaise Int
  quantity       Int
  stockReserved  Boolean @default(true)
  variantId      String?
  variantLabel   String?
  gstRate        Int     @default(0)
  hsnCode        String?

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

model Payment {
  id                String   @id @default(cuid())
  orderId           String
  provider          String
  providerPaymentId String
  method            String?
  amountPaise       Int
  status            String
  createdAt         DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, providerPaymentId])
}

model Refund {
  id               String   @id @default(cuid())
  orderId          String
  providerRefundId String   @unique
  amountPaise      Int
  status           String
  createdById      String
  createdAt        DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id         String   @id
  shopId     String
  event      String
  receivedAt DateTime @default(now())
}

model SimulatedPayment {
  id              String   @id
  shopId          String
  providerOrderId String
  activeKey       String?  @unique
  amountPaise     Int
  method          String
  scenario        String
  status          String
  settlesAt       DateTime
  webhookLog      String   @default("")
  createdAt       DateTime @default(now())

  @@index([shopId, providerOrderId])
}

model Category {
  id        String   @id @default(cuid())
  shopId    String
  name      String
  imageUrl  String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([shopId, name])
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  label      String
  pricePaise Int
  stock      Int         @default(0)
  position   Int         @default(0)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

model CustomerAccount {
  id           String            @id @default(cuid())
  shopId       String
  email        String
  name         String
  phone        String
  passwordHash String
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  pincode      String?
  createdAt    DateTime          @default(now())
  shop         Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders       Order[]
  sessions     CustomerSession[]

  @@unique([shopId, email])
}

model CustomerSession {
  id        String          @id
  accountId String
  expiresAt DateTime
  createdAt DateTime        @default(now())
  account   CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model PasswordResetToken {
  id                String    @id
  userId            String?
  customerAccountId String?
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime  @default(now())
}

model ShopPolicy {
  id        String   @id @default(cuid())
  shopId    String
  slug      String
  title     String
  body      String
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, slug])
}

model OutboundEmail {
  id        String   @id @default(cuid())
  shopId    String?
  to        String
  subject   String
  text      String
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([shopId, createdAt])
}
