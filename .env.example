# Supabase (Project → Connect). Use the "Transaction pooler" string for DATABASE_URL and the
# "Session pooler" string for DIRECT_URL and SHADOW_DATABASE_URL. Replace [YOUR-PASSWORD].
# Tables live in a private schema: "dev" on your laptop, "app" for pre-prod. Never "public".
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?schema=dev"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?schema=dev"
# Local only: an empty schema Prisma uses to check new migrations
SHADOW_DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/prisma_shadow?schema=dev"


# Platform domain; shops live on <slug>.<ROOT_DOMAIN>
ROOT_DOMAIN="localhost:3000"

# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Set to "true" only behind a proxy that sets X-Forwarded-For (e.g. Vercel); used for rate limiting
TRUST_PROXY_HEADERS="false"

# Used by `npm run db:seed` for local development only
SEED_PLATFORM_ADMIN_EMAIL="platform@namma-angadi.test"
SEED_PLATFORM_ADMIN_PASSWORD=""
SEED_SHOP_OWNER_EMAIL="owner@ravi-textiles.test"
SEED_SHOP_OWNER_PASSWORD=""

# Photo storage. Leave empty to keep photos on this computer (uploads/).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="media"

# Pre-prod: allow the UPI simulator outside development and show a test-site banner
ENABLE_TEST_PAYMENTS="false"
SITE_MODE=""

# Email (optional). Without these, emails are only written to the email log.
RESEND_API_KEY=""
EMAIL_FROM=""
